{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kakashi3lite/firmgap/schemas/compliance_dossier.schema.json",
  "title": "firmgap compliance audit dossier",
  "description": "Canonical JSON (keys sorted, no whitespace, JSON.stringify number format, numbers quantised to 1e-4). dossier_sha256 = SHA-256 of the canonical JSON of the object without dossier_sha256. Verify with `firmgap audit --verify`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "engine_version",
    "rulepack_id",
    "jurisdiction",
    "scenario_sha256",
    "inputs",
    "shedding_curve",
    "compliance",
    "repro_command",
    "seed",
    "dossier_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "engine_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "rulepack_id": {
      "enum": [
        "TX-SB6-16TAC25.194-2026.10",
        "US-FERC-RM26-4-2026.01",
        "US-VA-SB253-2026.06",
        "GB-NESO-OFGEM-DC-2026.09",
        "IE-CRU-2025-236-2026.05",
        "ES-RD-1032-2026.11",
        "SG-IMDA-GDCR-DCCFA2-2026.03",
        "EU-EED-ART12-2026.01"
      ]
    },
    "jurisdiction": {
      "enum": [
        "ercot-sb6",
        "ferc-rm26-4",
        "va-sb253",
        "uk-neso",
        "ie-cru",
        "es-rd",
        "sg-gdc",
        "eu-eed"
      ]
    },
    "scenario_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "params",
        "site"
      ],
      "properties": {
        "params": {
          "type": "object",
          "description": "All simulation parameters (see `firmgap params`) plus seed and strategy",
          "additionalProperties": {
            "type": [
              "number",
              "string"
            ]
          }
        },
        "site": {
          "type": "object",
          "description": "Resolved compliance site profile (see schemas/compliance_rulepack.schema.json)",
          "additionalProperties": {
            "type": [
              "number",
              "boolean"
            ]
          }
        }
      }
    },
    "shedding_curve": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classes",
        "points",
        "required_shed_mw",
        "bess_mw_without_shed",
        "bess_mwh_without_shed",
        "bess_mw_with_shed",
        "bess_mwh_with_shed",
        "capex_without_shed_usd",
        "capex_with_shed_usd",
        "capex_avoided_usd",
        "cycling_cost_avoided_usd_per_year"
      ],
      "properties": {
        "classes": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "nominal_mw",
              "u_min",
              "beta",
              "value_per_mwh",
              "sla_slack_hours"
            ],
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 32
              },
              "nominal_mw": {
                "type": "number",
                "minimum": 0
              },
              "u_min": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "beta": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "value_per_mwh": {
                "type": "number",
                "minimum": 0
              },
              "sla_slack_hours": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "points": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "duration_min",
              "certified_shed_mw",
              "target_shed_mw",
              "marginal_shadow_price_per_mwh",
              "bess_mwh_displaced"
            ],
            "properties": {
              "duration_min": {
                "type": "number",
                "minimum": 0
              },
              "certified_shed_mw": {
                "type": "number",
                "minimum": 0
              },
              "target_shed_mw": {
                "type": "number",
                "minimum": 0
              },
              "marginal_shadow_price_per_mwh": {
                "type": "number",
                "minimum": 0
              },
              "bess_mwh_displaced": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "required_shed_mw": {
          "type": "number"
        },
        "bess_mw_without_shed": {
          "type": "number"
        },
        "bess_mwh_without_shed": {
          "type": "number"
        },
        "bess_mw_with_shed": {
          "type": "number"
        },
        "bess_mwh_with_shed": {
          "type": "number"
        },
        "capex_without_shed_usd": {
          "type": "number"
        },
        "capex_with_shed_usd": {
          "type": "number"
        },
        "capex_avoided_usd": {
          "type": "number"
        },
        "cycling_cost_avoided_usd_per_year": {
          "type": "number"
        }
      }
    },
    "compliance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rulepack_id",
        "jurisdiction",
        "verdict",
        "checks",
        "financial_drag",
        "remediations"
      ],
      "properties": {
        "rulepack_id": {
          "enum": [
            "TX-SB6-16TAC25.194-2026.10",
            "US-FERC-RM26-4-2026.01",
            "US-VA-SB253-2026.06",
            "GB-NESO-OFGEM-DC-2026.09",
            "IE-CRU-2025-236-2026.05",
            "ES-RD-1032-2026.11",
            "SG-IMDA-GDCR-DCCFA2-2026.03",
            "EU-EED-ART12-2026.01"
          ]
        },
        "jurisdiction": {
          "enum": [
            "ercot-sb6",
            "ferc-rm26-4",
            "va-sb253",
            "uk-neso",
            "ie-cru",
            "es-rd",
            "sg-gdc",
            "eu-eed"
          ]
        },
        "verdict": {
          "enum": [
            "BankablePass",
            "ConditionalWarning",
            "StatutoryBlocker"
          ]
        },
        "checks": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule_id",
              "citation",
              "severity",
              "passed",
              "observed",
              "limit",
              "unit",
              "summary"
            ],
            "properties": {
              "rule_id": {
                "type": "string",
                "pattern": "^[A-Z0-9_]{3,40}$"
              },
              "citation": {
                "type": "string",
                "maxLength": 1000
              },
              "severity": {
                "enum": [
                  "Blocker",
                  "Warning",
                  "Info"
                ]
              },
              "passed": {
                "type": "boolean"
              },
              "observed": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "limit": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "unit": {
                "type": "string",
                "maxLength": 16
              },
              "summary": {
                "type": "string",
                "maxLength": 1000
              }
            }
          }
        },
        "financial_drag": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "study_fee_usd",
            "security_locked_usd",
            "security_months_equivalent",
            "working_capital_carry_usd",
            "forfeiture_exposure_usd",
            "expected_forfeiture_usd",
            "sla_ld_exposure_usd_per_year",
            "total_drag_usd"
          ],
          "properties": {
            "study_fee_usd": {
              "type": "number",
              "minimum": 0
            },
            "security_locked_usd": {
              "type": "number",
              "minimum": 0
            },
            "security_months_equivalent": {
              "type": "number",
              "minimum": 0
            },
            "working_capital_carry_usd": {
              "type": "number",
              "minimum": 0
            },
            "forfeiture_exposure_usd": {
              "type": "number",
              "minimum": 0
            },
            "expected_forfeiture_usd": {
              "type": "number",
              "minimum": 0
            },
            "sla_ld_exposure_usd_per_year": {
              "type": "number",
              "minimum": 0
            },
            "total_drag_usd": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "remediations": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "rule_id",
              "title",
              "action",
              "changes",
              "value_usd_per_year",
              "pv_5y_usd",
              "delta_vs_other_usd_per_year",
              "capex_usd",
              "recommended",
              "resolves"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Z0-9_]{3,40}$"
              },
              "rule_id": {
                "type": "string"
              },
              "title": {
                "type": "string",
                "maxLength": 200
              },
              "action": {
                "type": "string",
                "maxLength": 1000
              },
              "changes": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "key",
                    "value"
                  ],
                  "properties": {
                    "key": {
                      "type": "string",
                      "pattern": "^[a-z0-9_]{1,64}$"
                    },
                    "value": {
                      "type": [
                        "number",
                        "boolean"
                      ]
                    }
                  }
                }
              },
              "value_usd_per_year": {
                "type": "number"
              },
              "pv_5y_usd": {
                "type": "number"
              },
              "delta_vs_other_usd_per_year": {
                "type": "number"
              },
              "capex_usd": {
                "type": "number",
                "minimum": 0
              },
              "recommended": {
                "type": "boolean"
              },
              "resolves": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "repro_command": {
      "type": "string",
      "pattern": "^firmgap audit --scenario [ -~]+ --jurisdiction (ercot-sb6|ferc-rm26-4|va-sb253|uk-neso|ie-cru|es-rd|sg-gdc|eu-eed)$",
      "maxLength": 600
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "dossier_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
