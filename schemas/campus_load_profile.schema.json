{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kakashi3lite/firmgap/schemas/campus_load_profile.schema.json",
  "title": "Campus load profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "site_id",
    "meter_id",
    "interval_minutes",
    "points"
  ],
  "properties": {
    "site_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "meter_id": {
      "type": "string",
      "maxLength": 64
    },
    "interval_minutes": {
      "type": "integer",
      "enum": [
        1,
        5,
        15,
        60
      ]
    },
    "basis": {
      "type": "string",
      "enum": [
        "poi_meter",
        "it_load",
        "modelled"
      ],
      "default": "poi_meter"
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 600000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "t",
          "mw"
        ],
        "properties": {
          "t": {
            "type": "string",
            "format": "date-time",
            "description": "UTC, ISO-8601 with Z suffix"
          },
          "mw": {
            "type": "number",
            "minimum": 0,
            "maximum": 5000
          },
          "quality": {
            "type": "string",
            "enum": [
              "good",
              "estimated",
              "suspect",
              "missing"
            ]
          }
        }
      }
    }
  }
}
