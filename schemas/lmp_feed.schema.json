{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kakashi3lite/firmgap/schemas/lmp_feed.schema.json",
  "title": "Nodal price feed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "iso",
    "node_id",
    "market",
    "interval_minutes",
    "points"
  ],
  "properties": {
    "iso": {
      "type": "string",
      "enum": [
        "PJM",
        "MISO",
        "SPP",
        "ERCOT",
        "CAISO",
        "NYISO",
        "ISONE",
        "OTHER"
      ]
    },
    "node_id": {
      "type": "string",
      "maxLength": 128
    },
    "market": {
      "type": "string",
      "enum": [
        "DA",
        "RT"
      ]
    },
    "interval_minutes": {
      "type": "integer",
      "enum": [
        5,
        15,
        60
      ]
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1200000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "t",
          "lmp"
        ],
        "properties": {
          "t": {
            "type": "string",
            "format": "date-time",
            "description": "UTC, ISO-8601 with Z suffix"
          },
          "lmp": {
            "type": "number",
            "minimum": -5000,
            "maximum": 20000
          },
          "energy": {
            "type": "number"
          },
          "congestion": {
            "type": "number"
          },
          "loss": {
            "type": "number"
          },
          "published_at": {
            "type": "string",
            "format": "date-time",
            "description": "UTC, ISO-8601 with Z suffix"
          },
          "quality": {
            "type": "string",
            "enum": [
              "good",
              "estimated",
              "suspect",
              "missing"
            ]
          }
        }
      }
    }
  }
}
