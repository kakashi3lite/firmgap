{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kakashi3lite/firmgap/schemas/batch_queue_sla.schema.json",
  "title": "Workload class SLA tiers",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "site_id",
    "effective_from",
    "classes"
  ],
  "properties": {
    "site_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "effective_from": {
      "type": "string",
      "format": "date-time",
      "description": "UTC, ISO-8601 with Z suffix"
    },
    "contract_ref": {
      "type": "string",
      "maxLength": 128
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "class_id",
          "deferrable",
          "mw_typical"
        ],
        "properties": {
          "class_id": {
            "type": "string",
            "maxLength": 64
          },
          "description": {
            "type": "string",
            "maxLength": 256
          },
          "deferrable": {
            "type": "boolean",
            "description": "Inference / latency-critical classes MUST be false"
          },
          "mw_typical": {
            "type": "number",
            "minimum": 0,
            "maximum": 5000
          },
          "max_hold_hours": {
            "type": "number",
            "minimum": 0,
            "maximum": 48
          },
          "sla_window_hours": {
            "type": "number",
            "minimum": 0,
            "maximum": 168
          },
          "instant_power_cap_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "preemption_latency_s": {
            "type": "number",
            "minimum": 0,
            "maximum": 3600
          },
          "deferral_fee_usd_per_mwh": {
            "type": "number",
            "minimum": 0,
            "maximum": 100000
          },
          "late_penalty_usd_per_mwh": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "if": {
          "properties": {
            "deferrable": {
              "const": true
            }
          }
        },
        "then": {
          "required": [
            "max_hold_hours",
            "sla_window_hours"
          ]
        }
      }
    }
  }
}
